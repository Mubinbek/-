# ── Twilio ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic (Claude) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── База данных ───────────────────────────────────────────────────────────
# PostgreSQL (по умолчанию):
DATABASE_URL=postgresql://user:password@localhost:5432/phone_agent

# MySQL (если нужен — также поменяйте DATABASE_DRIVER):
# DATABASE_URL=mysql://user:password@localhost:3306/phone_agent
# DATABASE_DRIVER=mysql

DATABASE_DRIVER=postgres

# ── Сервер ────────────────────────────────────────────────────────────────
PORT=8000
DEBUG=false

# Публичный URL сервера (для Twilio webhook, можно через ngrok)
# PUBLIC_URL=https://your-domain.com
